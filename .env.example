# Time zone of the match dates/times (default Asia/Kolkata = India time). Keep it the same as the public website.
NEXT_PUBLIC_MATCH_TIME_ZONE=Asia/Kolkata

# ---- Hourly auto-import (see .github/workflows/hourly-import.yml) ----
# Long random text; the same value goes into the GitHub secret CRON_SECRET. Example: openssl rand -hex 32
CRON_SECRET=
# Server only (never NEXT_PUBLIC_): lets the hourly import write to the database without a logged-in admin.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdzbHltenBiY2NydHRiY3NoaHRtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MzgyMTY0MiwiZXhwIjoyMTA5Mzk3NjQyfQ.tfnaKIymSqH2odQ1-tZ4rDM8uyin81Q-NUdfrT3jN1M

# Optional. The JSON feed to import. Default: the Upcoming-and-Live-Sports-Data repository.
SPORTS_FEED_URL=https://raw.githubusercontent.com/sm-monirulislam/Upcoming-and-Live-Sports-Data/main/Sports_data.json
# Optional. Two more feeds that are imported every hour: their streaming links are added to the matching cards
# (a match that only they have gets its own card). Defaults are the Tapmad and SonyLiv repositories.
TAPMAD_FEED_URL=https://raw.githubusercontent.com/sm-monirulislam/Tapmad_Auto_Update_Playlist/main/tapmad_data.json
SONYLIV_FEED_URL=https://raw.githubusercontent.com/sm-monirulislam/SonyLiv_Event_Playlist/main/sonyLiv_data.json
